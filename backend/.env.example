# ---- Banco de dados (Supabase) ----
# Pegue em: Supabase > Project Settings > Database > Connection string
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cafelio
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=sua-senha-do-banco

# ---- Login com Google ----
# Pegue em: Google Cloud Console > Credenciais > ID do cliente OAuth
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com

# ---- JWT ----
# Qualquer texto longo e aleatório. Cada uma pode ter o seu.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
JWT_EXPIRATION_MS=86400000

# ---- E-mail (Gmail do Cafélio) ----
# A senha é uma "senha de app", gerada depois de ativar
# a verificação em duas etapas na conta. Não é a senha do Gmail.
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx